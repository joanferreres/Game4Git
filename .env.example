# SHA-256 hash of the admin panel password.
# Linux: echo -n "yourpassword" | sha256sum
# macOS: echo -n "yourpassword" | shasum -a 256
# Set this in Vercel dashboard → Settings → Environment Variables
VITE_ADMIN_PASSWORD_HASH=

# Optional: Sentry DSN for error tracking in production.
# Get it from https://sentry.io after creating a project.
VITE_SENTRY_DSN=
