    "seeDetails": "Voir détails",
    "commonUseCases": {
      "title": "Cas d'Usage Courants",
      "useCase1": {
        "title": "Compiler avec informations de debug",
        "description": "Utiliser les flags -g et -O0 pour activer un débogage efficace",
        "explanation": "La compilation avec informations de debug est la première étape cruciale :\n\n• -g: Inclut les informations de debug\n• -O0: Désactive les optimisations pour un débogage plus clair\n• -Wall: Affiche les avertissements du compilateur\n• -Wextra: Avertissements supplémentaires\n\nCette combinaison assure que vous ayez toutes les informations nécessaires pour un débogage efficace.",
        "example": "gcc -g -O0 -Wall -Wextra -o mon_programme mon_programme.c\ngdb ./mon_programme"
      },
      "useCase2": {
        "title": "Définir des breakpoints stratégiques",
        "description": "Placer des breakpoints aux points clés pour contrôler l'exécution",
        "explanation": "Les breakpoints stratégiques sont fondamentaux pour contrôler l'exécution :\n\n• break fonction: Pause en entrant dans une fonction\n• break fichier.c:ligne: Pause à une ligne spécifique\n• break +N: Pause N lignes après l'actuelle\n• break -N: Pause N lignes avant l'actuelle\n\nUtiliser des breakpoints vous permet de sauter directement aux parties problématiques du code.",
        "example": "(gdb) break main\n(gdb) break problematic_function\n(gdb) break file.c:42\n(gdb) run"
      },
      "useCase3": {
        "title": "Inspecter variables et mémoire",
        "description": "Examiner l'état des variables et structures de données",
        "explanation": "L'inspection des variables est essentielle pour comprendre l'état du programme :\n\n• print var: Affiche la valeur d'une variable\n• print *ptr: Affiche la valeur pointée par un pointeur\n• print arr[0]@10: Affiche 10 éléments d'un tableau\n• display var: Affiche automatiquement la variable à chaque étape\n\nCela vous permet de voir exactement ce qui se passe avec vos données.",
        "example": "(gdb) print counter\n(gdb) print *pointer\n(gdb) print array[0]@5\n(gdb) display important_var"
      },
      "useCase4": {
        "title": "Analyser les stack traces",
        "description": "Comprendre le flux d'exécution par l'analyse de la pile",
        "explanation": "L'analyse des stack traces est cruciale pour comprendre le flux d'exécution :\n\n• backtrace: Affiche la pile d'appels complète\n• frame N: Change vers le frame N de la pile\n• up: Monte d'un niveau dans la pile\n• down: Descend d'un niveau dans la pile\n• info locals: Affiche les variables locales du frame actuel\n\nCela vous aide à comprendre comment vous êtes arrivé au point d'exécution actuel.",
        "example": "(gdb) backtrace\n(gdb) frame 2\n(gdb) info locals"
      }
    },
    "bestPractices": {
      "title": "Meilleures Pratiques",
      "practicesTitle": "Pratiques Recommandées",
      "practice1": {
        "title": "Compiler avec informations de debug",
        "description": "Utiliser les flags -g et -O0 pour obtenir des informations détaillées de debug"
